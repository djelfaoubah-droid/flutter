                            borderRadius: BorderRadius.circular(8.0),
                            child: Image.network(
                              storeImage,
                              width: 50,
                              height: 50,
                              fit: BoxFit.cover,
                              errorBuilder: (BuildContext ctx, Object error, StackTrace? stackTrace) {
                                return Container(
                                  width: 50,
                                  height: 50,
                                  color: Colors.grey[200],
                                  child: const Icon(Icons.store, size: 30, color: Colors.grey),
                                );
                              },
                            ),
                          ),
                          title: Text(storeName, textAlign: TextAlign.right, style: const TextStyle(fontWeight: FontWeight.bold)),
                          trailing: ElevatedButton(
                            onPressed: () {
                              userData.followStore(storeId);
                              ScaffoldMessenger.of(context).showSnackBar(
                                SnackBar(content: Text('تمت متابعة محل "$storeName" بنجاح!')),
                              );
                              Navigator.pop(dialogContext);
                            },
                            style: ElevatedButton.styleFrom(
                              backgroundColor: primaryColor,
                              minimumSize: Size.zero,
                              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 5),
                            ),
                            child: const Text('متابعة', style: TextStyle(fontSize: 14)),
                          ),
                        ),
                      );
                    },
                  ),
                ),
          actions: <Widget>[
            TextButton(
              onPressed: () => Navigator.pop(dialogContext),
              child: const Text('إلغاء'),
            ),
          ],
        );
      },
    );
  }
}

