/// Form for adding or editing a product
class ProductForm extends StatelessWidget {
  final ProductManagementData productData;
  final bool isEditing;
  final Product? originalProduct;
  final VoidCallback onSave;

  const ProductForm({
    required this.productData,
    required this.isEditing,
    this.originalProduct,
    required this.onSave,
    super.key,
  });

  @override
  Widget build(BuildContext context) {
    return ChangeNotifierProvider<ProductManagementData>.value(
      value: productData,
      builder: (BuildContext providerContext, Widget? child) {
        return Consumer<ProductManagementData>(
          builder: (BuildContext consumerContext, ProductManagementData pData, Widget? consumerChild) {
            return Form(
              key: pData.formKey,
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: <Widget>[
                  Text(
                    isEditing ? 'تعديل المنتج' : 'إضافة منتج جديد',
                    style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold, color: primaryColor),
                    textAlign: TextAlign.center,
                  ),
                  const SizedBox(height: 20),
                  AppTextField(
                    label: 'اسم المنتج',
                    controller: pData.nameController,
                    hint: 'أدخل اسم المنتج',
                    validator: (String? value) => (value == null || value.isEmpty) ? 'الرجاء إدخال اسم المنتج' : null,
                  ),
                  AppTextField(
                    label: 'وصف المنتج',
                    controller: pData.descriptionController,
                    hint: 'وصف مختصر للمنتج',
                    maxLines: 3,
                  ),
                  AppTextField(
                    label: 'سعر المنتج (دج)',
                    controller: pData.priceController,
                    hint: 'أدخل سعر المنتج',
                    keyboardType: TextInputType.number,
                    validator: (String? value) {
                      if (value == null || value.isEmpty) return 'الرجاء إدخال السعر';
                      if (double.tryParse(value) == null) return 'الرجاء إدخال رقم صحيح';
                      if (double.parse(value) <= 0) return 'السعر يجب أن يكون أكبر من صفر';
                      return null;
                    },
                  ),
                  AppTextField(
                    label: 'رابط صورة المنتج (اختياري)',
                    controller: pData.imageUrlController,
                    hint: 'https://example.com/image.jpg',
                    keyboardType: TextInputType.url,
                    validator: (String? value) {
                      if (value != null && value.isNotEmpty) {
                        final Uri? uri = Uri.tryParse(value);
                        if (uri == null || !uri.isAbsolute) {
                          return 'الرجاء إدخال رابط صحيح';
                        }
                      }
                      return null;
                    },
                  ),
                  ProductCategoryDropdown(productData: pData),
                  AppTextField(
                    label: 'الكمية في المخزون',
                    controller: pData.stockController,
                    hint: 'أدخل الكمية المتوفرة',
                    keyboardType: TextInputType.number,
                    validator: (String? value) {
                      if (value == null || value.isEmpty) return 'الرجاء إدخال الكمية';
                      if (int.tryParse(value) == null) return 'الرجاء إدخال رقم صحيح للكمية';
                      if (int.parse(value) < 0) return 'الكمية لا يمكن أن تكون سالبة';
                      return null;
                    },
                  ),
                  SwitchListTile(
                    title: const Align(
                      alignment: Alignment.centerRight,
                      child: Text(
                        'تفعيل التخفيض',
                        style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: Colors.black87),
                      ),
                    ),
                    value: pData.isDiscountEnabled,
                    onChanged: (bool value) {
                      pData.setIsDiscountEnabled(value);
                    },
                    activeThumbColor: primaryColor,
                  ),
                  if (pData.isDiscountEnabled)
                    AppTextField(
                      label: 'سعر التخفيض (دج)',
                      controller: pData.discountPriceController,
                      hint: 'أدخل سعر التخفيض',
                      keyboardType: TextInputType.number,
                      validator: (String? value) {
                        if (value == null || value.isEmpty) return 'الرجاء إدخال سعر التخفيض';
                        final double? discountPrice = double.tryParse(value);
                        if (discountPrice == null) return 'الرجاء إدخال رقم صحيح';
                        final double? originalPrice = double.tryParse(pData.priceController.text);
                        if (originalPrice == null || discountPrice >= originalPrice) {
                          return 'يجب أن يكون سعر التخفيض أقل من السعر الأصلي';
                        }
                        return null;
                      },
                    ),
                  const SizedBox(height: 20),
                  ElevatedButton(
                    style: ElevatedButton.styleFrom(
                      backgroundColor: primaryColor,
                      minimumSize: const Size(double.infinity, 50),
                    ),
                    onPressed: () {
                      if (pData.formKey.currentState!.validate()) {
                        if (isEditing) {
                          pData.updateProduct(originalProduct!);
                        } else {
                          pData.addProduct();
                        }
                        onSave();
                      }
                    },
                    child: Text(isEditing ? 'حفظ التغييرات' : 'إضافة المنتج', style: const TextStyle(fontSize: 18)),
                  ),
                  const SizedBox(height: 10),
                  TextButton(
                    onPressed: () => Navigator.pop(consumerContext),
                    child: const Text('إلغاء', style: TextStyle(fontSize: 18, color: Colors.grey)),
                  ),
                ],
              ),
            );
          },
        );
      },
    );
  }
}

