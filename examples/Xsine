/// Product Data Model
class Product {
  final String id;
  String name;
  String description;
  double price;
  String imageUrl;
  String category;
  double? discountPrice;
  bool isDiscounted;
  int stock;

  Product({
    required this.id,
    required this.name,
    required this.description,
    required this.price,
    required this.imageUrl,
    required this.category,
    this.discountPrice,
    this.isDiscounted = false,
    this.stock = 0,
  });

  Product copyWith({
    String? id,
    String? name,
    String? description,
    double? price,
    String? imageUrl,
    String? category,
    double? discountPrice,
    bool? isDiscounted,
    int? stock,
  }) {
    return Product(
      id: id ?? this.id,
      name: name ?? this.name,
      description: description ?? this.description,
      price: price ?? this.price,
      imageUrl: imageUrl ?? this.imageUrl,
      category: category ?? this.category,
      discountPrice: discountPrice ?? this.discountPrice,
      isDiscounted: isDiscounted ?? this.isDiscounted,
      stock: stock ?? this.stock,
    );
  }
}

/// Data model for managing products
class ProductManagementData extends ChangeNotifier {
  final List<Product> _products = <Product>[
    Product(
      id: '1',
      name: 'هاتف ذكي X1',
      description: 'هاتف ذكي بخصائص ممتازة وبطارية تدوم طويلاً.',
      price: 25000.0,
      imageUrl: 'https://www.gstatic.com/flutter-onestack-prototype/genui/example_1.jpg',
      category: 'إلكترونيات',
      discountPrice: 22000.0,
      isDiscounted: true,
      stock: 50,
    ),
    Product(
      id: '2',
      name: 'قميص رجالي',
      description: 'قميص أنيق ومريح مصنوع من القطن الخالص.',
      price: 1500.0,
      imageUrl: 'https://www.gstatic.com/flutter-onestack-prototype/genui/example_1.jpg',
      category: 'ملابس',
      discountPrice: null,
      isDiscounted: false,
      stock: 120,
    ),
    Product(
      id: '3',
      name: 'قهوة سريعة التحضير',
      description: 'قهوة فاخرة بطعم غني ورائحة عطرة.',
      price: 750.0,
      imageUrl: 'https://www.gstatic.com/flutter-onestack-prototype/genui/example_1.jpg',
      category: 'أطعمة ومشروبات',
      discountPrice: 600.0,
      isDiscounted: true,
      stock: 200,
    ),
  ];

  final TextEditingController _nameController;
  final TextEditingController _descriptionController;
  final TextEditingController _priceController;
  final TextEditingController _imageUrlController;
  final TextEditingController _discountPriceController;
  final TextEditingController _stockController;
  String? _selectedCategory;
  bool _isDiscountEnabled;
  final GlobalKey<FormState> _formKey = GlobalKey<FormState>();

  ProductManagementData()
      : _nameController = TextEditingController(),
        _descriptionController = TextEditingController(),
        _priceController = TextEditingController(),
        _imageUrlController = TextEditingController(),
        _discountPriceController = TextEditingController(),
        _stockController = TextEditingController(),
        _selectedCategory = availableProductCategories.first,
        _isDiscountEnabled = false;

  List<Product> get products => List<Product>.unmodifiable(_products);
  TextEditingController get nameController => _nameController;
  TextEditingController get descriptionController => _descriptionController;
  TextEditingController get priceController => _priceController;
  TextEditingController get imageUrlController => _imageUrlController;
  TextEditingController get discountPriceController => _discountPriceController;
  TextEditingController get stockController => _stockController;
  String? get selectedCategory => _selectedCategory;
  bool get isDiscountEnabled => _isDiscountEnabled;
  GlobalKey<FormState> get formKey => _formKey;

  static const List<String> availableProductCategories = <String>[
    'إلكترونيات',
    'ملابس',
    'أطعمة ومشروبات',
    'منزل وحديقة',
    'رياضة',
    'كتب',
    'أخرى',
  ];

  void setSelectedCategory(String? newCategory) {
    if (_selectedCategory != newCategory) {
      _selectedCategory = newCategory;
      notifyListeners();
    }
  }

  void setIsDiscountEnabled(bool value) {
    _isDiscountEnabled = value;
    if (!value) {
      _discountPriceController.clear();
    }
    notifyListeners();
  }

  void addProduct() {
    if (_formKey.currentState!.validate()) {
      final double price = double.parse(_priceController.text);
      final double? discountPrice = _discountPriceController.text.isNotEmpty
          ? double.tryParse(_discountPriceController.text)
          : null;
      final int stock = int.parse(_stockController.text);

      final Product newProduct = Product(
        id: DateTime.now().millisecondsSinceEpoch.toString(),
        name: _nameController.text,
        description: _descriptionController.text,
        price: price,
        imageUrl: _imageUrlController.text.isEmpty
            ? 'https://www.gstatic.com/flutter-onestack-prototype/genui/example_1.jpg'
            : _imageUrlController.text,
        category: _selectedCategory!,
        discountPrice: _isDiscountEnabled ? discountPrice : null,
        isDiscounted: _isDiscountEnabled && discountPrice != null && discountPrice < price,
        stock: stock,
      );
      _products.add(newProduct);
      clearControllers();
      notifyListeners();
    }
  }

  void updateProduct(Product originalProduct) {
    if (_formKey.currentState!.validate()) {
      final int index = _products.indexWhere((Product p) => p.id == originalProduct.id);
      if (index != -1) {
        final double price = double.parse(_priceController.text);
        final double? discountPrice = _discountPriceController.text.isNotEmpty
            ? double.tryParse(_discountPriceController.text)
            : null;
        final int stock = int.parse(_stockController.text);

        _products[index] = originalProduct.copyWith(
          name: _nameController.text,
          description: _descriptionController.text,
          price: price,
          imageUrl: _imageUrlController.text.isEmpty
              ? 'https://www.gstatic.com/flutter-onestack-prototype/genui/example_1.jpg'
              : _imageUrlController.text,
          category: _selectedCategory,
          discountPrice: _isDiscountEnabled ? discountPrice : null,
          isDiscounted: _isDiscountEnabled && discountPrice != null && discountPrice < price,
          stock: stock,
        );
        clearControllers();
        notifyListeners();
      }
    }
  }

  void deleteProduct(String id) {
    _products.removeWhere((Product product) => product.id == id);
    notifyListeners();
  }

  void setProductForEdit(Product product) {
    _nameController.text = product.name;
    _descriptionController.text = product.description;
    _priceController.text = product.price.toStringAsFixed(2);
    _imageUrlController.text = product.imageUrl;
    _selectedCategory = product.category;
    _discountPriceController.text = product.discountPrice?.toStringAsFixed(2) ?? '';
    _stockController.text = product.stock.toString();
    _isDiscountEnabled = product.isDiscounted && (product.discountPrice != null && product.discountPrice! < product.price);
    notifyListeners();
  }

  void clearControllers() {
    _nameController.clear();
    _descriptionController.clear();
    _priceController.clear();
    _imageUrlController.clear();
    _discountPriceController.clear();
    _stockController.clear();
    _selectedCategory = availableProductCategories.first;
    _isDiscountEnabled = false;
    notifyListeners();
  }

  @override
  void dispose() {
    _nameController.dispose();
    _descriptionController.dispose();
    _priceController.dispose();
    _imageUrlController.dispose();
    _discountPriceController.dispose();
    _stockController.dispose();
    super.dispose();
  }
}

