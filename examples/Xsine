/// Data model for managing store interface details
class StoreManagementData extends ChangeNotifier {
  final TextEditingController _storeNameController;
  final TextEditingController _phoneNumberController;
  final TextEditingController _descriptionController;
  final TextEditingController _addressController;
  final TextEditingController _openingTimeController;
  final TextEditingController _closingTimeController;
  final TextEditingController _socialMediaLinkController;

  String _storeImageUrl;
  String? _selectedCategory;

  final GlobalKey<FormState> _formKey = GlobalKey<FormState>();

  StoreManagementData()
      : _storeNameController = TextEditingController(text: 'متجر الأحلام'),
        _phoneNumberController = TextEditingController(text: '0550123456'),
        _descriptionController = TextEditingController(text: 'متجرك المفضل لكل ما تحتاجه!'),
        _addressController = TextEditingController(text: '123 الشارع الرئيسي، المدينة'),
        _openingTimeController = TextEditingController(text: '09:00 صباحًا'),
        _closingTimeController = TextEditingController(text: '09:00 مساءً'),
        _socialMediaLinkController = TextEditingController(text: 'https://facebook.com/my_dream_store'),
        _storeImageUrl = 'https://www.gstatic.com/flutter-onestack-prototype/genui/example_1.jpg',
        _selectedCategory = 'إلكترونيات';

  TextEditingController get storeNameController => _storeNameController;
  TextEditingController get phoneNumberController => _phoneNumberController;
  TextEditingController get descriptionController => _descriptionController;
  TextEditingController get addressController => _addressController;
  TextEditingController get openingTimeController => _openingTimeController;
  TextEditingController get closingTimeController => _closingTimeController;
  TextEditingController get socialMediaLinkController => _socialMediaLinkController;
  String get storeImageUrl => _storeImageUrl;
  String? get selectedCategory => _selectedCategory;
  GlobalKey<FormState> get formKey => _formKey;

  static const List<String> availableCategories = <String>[
    'إلكترونيات',
    'ملابس',
    'أطعمة ومشروبات',
    'منزل وحديقة',
    'أخرى',
  ];

  void setSelectedCategory(String? newCategory) {
    if (_selectedCategory != newCategory) {
      _selectedCategory = newCategory;
      notifyListeners();
    }
