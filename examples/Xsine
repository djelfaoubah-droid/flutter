      orderDate: DateTime.now().subtract(const Duration(hours: 20)),
    ),
  ];

  List<Order> get allOrders => List<Order>.unmodifiable(_orders);

  List<Order> get pendingOrders =>
      _orders.where((Order order) => order.status == OrderStatus.pending).toList();

  List<Order> get confirmedOrders =>
      _orders.where((Order order) => order.status == OrderStatus.confirmed).toList();

  List<Order> get inProgressOrders =>
      _orders.where((Order order) => order.status == OrderStatus.inProgress).toList();

  List<Order> get deliveredOrders =>
      _orders.where((Order order) => order.status == OrderStatus.delivered).toList();

  List<Order> get cancelledOrders =>
      _orders.where((Order order) => order.status == OrderStatus.cancelled).toList();

  void updateOrderStatus(String orderId, OrderStatus newStatus) {
    final int index = _orders.indexWhere((Order order) => order.id == orderId);
    if (index != -1) {
      _orders[index] = _orders[index].copyWith(status: newStatus);
      notifyListeners();
    }
  }

  void addOrder(Order order) {
    _orders.add(order);
    notifyListeners();
  }

  void deleteOrder(String orderId) {
    _orders.removeWhere((Order order) => order.id == orderId);
    notifyListeners();
  }
}

