              const SizedBox(height: 10),
              AppButton(text: 'إرسال', color: primaryColor, onPressed: () {
                setState(() {
                  response = _getChatbotResponse(_chatController.text, userData);
                  _chatController.clear();
                });
              }, minimumSize: const Size(double.infinity, 40)),
              if (response != null) ...<Widget>[
                const SizedBox(height: 10),
                Text(response!, textAlign: TextAlign.center),
              ],
            ],
          ),
        ),
      ],
    );
  }

  String _getChatbotResponse(String query, NormalUserData? userData) {
    final String lowerQuery = query.toLowerCase();

    if (lowerQuery.contains('مرحبا') || lowerQuery.contains('اهلا')) {
      return 'أهلاً بك! كيف يمكنني مساعدتك اليوم؟';
    } else if (lowerQuery.contains('اسمي') || lowerQuery.contains('من انا')) {
      if (userData != null) {
        return 'أنت ${userData.username}، أليس كذلك؟ يسعدني خدمتك.';
      }
      return 'أنا لا أمتلك معلومات شخصية عنك حاليًا. كيف يمكنني مساعدتك؟';
    } else if (lowerQuery.contains('المحلات المتابعة') || lowerQuery.contains('متابعة المحلات')) {
      if (userData != null && userData.followedStoreIds.isNotEmpty) {
        final List<String> followedNames = userData.followedStoreIds
            .map<String>((String id) => userData.getStoreNameById(id))
            .toList();
        return 'أنت تتابع حاليًا: ${followedNames.join(', ')}. هل تود استكشاف محلات جديدة؟';
      }
      return 'أنت لا تتابع أي محلات حتى الآن. هل تود أن أساعدك في العثور على محلات رائعة؟';
    } else if (lowerQuery.contains('المنتجات') || lowerQuery.contains('شراء')) {
      return 'يمكنك تصفح المنتجات في المحلات المختلفة. إذا كنت صاحب محل، يمكنك إدارة منتجاتك من قسم "إدارة المنتجات".';
    } else if (lowerQuery.contains('التوصيل')) {
      return 'خدمة التوصيل متاحة في حساب التوصيل، تحقق من قائمة الطلبات لتتبع طلباتك أو إدارة مهام التوصيل.';
    } else if (lowerQuery.contains('تخفيض') || lowerQuery.contains('عروض')) {
      return 'لدينا دائمًا أفضل العروض والتخفيض! تفقد قسم "التخفيض" في الشاشة الرئيسية.';
    } else {
      return 'عذرًا، لم أفهم استفسارك. يرجى إعادة الصياغة أو طرح سؤال آخر.';
    }
  }

