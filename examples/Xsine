  void _showAccountDialogBasedOnType() {
    switch (widget.accountType) {
      case 'normal':
        _showNormalAccountDialog();
        break;
      case 'store':
        _showStoreAccountDialog();
        break;
      case 'delivery':
        _showDeliveryAccountDialog();
        break;
