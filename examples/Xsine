/// List view for orders in the delivery dashboard.
class OrderListView extends StatelessWidget {
  final List<Order> Function(DeliveryManagementData) getOrders;

  const OrderListView({
    required this.getOrders,
    super.key,
  });

  String _statusToString(OrderStatus status) {
    switch (status) {
      case OrderStatus.pending:
        return 'قيد الانتظار';
      case OrderStatus.confirmed:
        return 'مؤكدة';
      case OrderStatus.inProgress:
        return 'قيد التوصيل';
      case OrderStatus.delivered:
        return 'تم توصيلها';
      case OrderStatus.cancelled:
        return 'ملغاة';
    }
  }

  @override
  Widget build(BuildContext context) {
    return Consumer<DeliveryManagementData>(
      builder: (BuildContext context, DeliveryManagementData deliveryData, Widget? child) {
        final List<Order> orders = getOrders(deliveryData);
        if (orders.isEmpty) {
          return Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: <Widget>[
                const Icon(Icons.list_alt, size: 80, color: Colors.grey),
                const SizedBox(height: 10),
                Text(
                  'لا توجد طلبات في هذا التصنيف حاليًا.',
                  textAlign: TextAlign.center,
                  style: TextStyle(fontSize: 16, color: Colors.grey[700]),
                ),
              ],
            ),
          );
        }
        return ListView.builder(
          padding: const EdgeInsets.all(8.0),
          itemCount: orders.length,
          itemBuilder: (BuildContext context, int index) {
            final Order order = orders[index];
            return OrderListItem(
              order: order,
              onStatusChange: (OrderStatus newStatus) {
                deliveryData.updateOrderStatus(order.id, newStatus);
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(content: Text('تم تحديث حالة الطلب ${order.id} إلى ${_statusToString(newStatus)}')),
                );
              },
            );
          },
        );
      },
    );
  }
}

